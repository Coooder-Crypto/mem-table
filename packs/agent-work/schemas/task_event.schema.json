{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent_work.task_event",
  "title": "Agent Task Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_name", "status", "occurred_at"],
  "properties": {
    "task_name": {
      "type": "string"
    },
    "task_type": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["started", "completed", "failed"]
    },
    "duration_minutes": {
      "type": "number",
      "minimum": 0
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
