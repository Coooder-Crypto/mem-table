{
  "rules": [
    {
      "name": "bench_press_workout",
      "schema": "fitness.workout",
      "pattern": "(?:卧推|bench(?:\\s+press)?)\\s*([0-9]+(?:\\.[0-9]+)?)\\s*kg\\s*([0-9]+)\\s*[x×]\\s*([0-9]+)",
      "flags": "i",
      "confidence": 0.95,
      "fields": {
        "exercise": {
          "value": "bench_press"
        },
        "weight_kg": {
          "group": 1,
          "type": "number"
        },
        "sets": {
          "group": 2,
          "type": "integer"
        },
        "reps": {
          "group": 3,
          "type": "integer"
        },
        "occurred_at": {
          "event": "occurred_at"
        }
      }
    },
    {
      "name": "body_weight",
      "schema": "fitness.body_weight",
      "pattern": "体重\\s*([0-9]+(?:\\.[0-9]+)?)\\s*kg",
      "flags": "i",
      "confidence": 0.95,
      "fields": {
        "weight_kg": {
          "group": 1,
          "type": "number"
        },
        "occurred_at": {
          "event": "occurred_at"
        }
      }
    }
  ]
}
