{
  "name": "bench_progress",
  "collection": "fitness.workout",
  "filter": {
    "exercise": {
      "eq": "bench_press"
    }
  },
  "aggregate": {
    "max_weight": {
      "op": "max",
      "field": "weight_kg"
    }
  },
  "groupBy": {
    "field": "occurred_at",
    "interval": "week"
  }
}

